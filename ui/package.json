{
  "name": "locode-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LOCODE shell — React + TypeScript front end for the locode/server.py engine",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "test": "node --test test/*.test.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
